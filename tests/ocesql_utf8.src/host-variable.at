AT_SETUP([Japanese UTF-8 host variable])

AT_DATA([INSERTTBL.cbl], [
       IDENTIFICATION              DIVISION.
      ******************************************************************
       PROGRAM-ID.                 INSERTTBL.
      ******************************************************************
       DATA                        DIVISION.
      ******************************************************************
       WORKING-STORAGE             SECTION.
       01  TEST-DATA.
         03 FILLER       PIC X(28) VALUE "0001北海　太郎          0400".
         03 FILLER       PIC X(28) VALUE "0002青森　次郎          0350".
         03 FILLER       PIC X(28) VALUE "0003秋田　三郎          0300".
         03 FILLER       PIC X(28) VALUE "0004岩手　四郎          025p".
         03 FILLER       PIC X(28) VALUE "0005宮城　五郎          020p".
         03 FILLER       PIC X(28) VALUE "0006福島　六郎          0150".
         03 FILLER       PIC X(28) VALUE "0007栃木　七郎          010p".
         03 FILLER       PIC X(28) VALUE "0008茨城　八郎          0050".
         03 FILLER       PIC X(28) VALUE "0009群馬　九郎          020p".
         03 FILLER       PIC X(28) VALUE "0010埼玉　十郎          0350".
       01  TEST-DATA-R   REDEFINES TEST-DATA.
         03  TEST-TBL    OCCURS  10.
           05  TEST-NO             PIC S9(04).
           05  TEST-NAME           PIC  X(20) .
           05  TEST-SALARY         PIC S9(04).
       01  IDX                     PIC  9(02).
       01  SYS-TIME                PIC  9(08).
       
       EXEC SQL BEGIN DECLARE SECTION END-EXEC.
       01  データベース名            PIC  X(30) VALUE SPACE.
       01  ユーザー名                PIC  X(30) VALUE SPACE.
       01  パスワード                PIC  X(10) VALUE SPACE.
       01  EMP-REC-VARS.
         03  従業員番号              PIC S9(04) VALUE ZERO.
         03  氏名                   PIC  X(20) .
         03  給与                   PIC S9(04) VALUE ZERO.
       EXEC SQL END DECLARE SECTION END-EXEC.

       EXEC SQL INCLUDE SQLCA END-EXEC.
      ******************************************************************
       PROCEDURE                   DIVISION.
      ******************************************************************
       MAIN-RTN.
           DISPLAY "*** INSERTTBL STARTED ***".
           
      *    CONNECT
           MOVE  "<|DB_NAME|>@<|DB_HOST|>:<|DB_PORT|>"
             TO データベース名.
           MOVE  "<|DB_USER|>"
             TO ユーザー名.
           MOVE  "<|DB_PASSWORD|>"
             TO パスワード.
           EXEC SQL
               CONNECT :ユーザー名 IDENTIFIED BY :パスワード USING :データベース名 
           END-EXEC.
           IF  SQLCODE NOT = ZERO PERFORM ERROR-RTN STOP RUN.
           
      *    DROP TABLE
           EXEC SQL
               DROP TABLE IF EXISTS 従業員一覧
           END-EXEC.
           IF  SQLCODE NOT = ZERO PERFORM ERROR-RTN.
           
      *    CREATE TABLE 
           EXEC SQL
                CREATE TABLE 従業員一覧
                (
                    従業員番号      NUMERIC(4,0) NOT NULL,
                    氏名           CHAR(20),
                    給与           NUMERIC(4,0),
                    CONSTRAINT 従0 PRIMARY KEY (従業員番号)
                )
           END-EXEC.
           IF  SQLCODE NOT = ZERO PERFORM ERROR-RTN STOP RUN.
           
      *    INSERT ROWS USING LITERAL
           EXEC SQL
               INSERT INTO 従業員一覧 VALUES (46, '鹿児島　六郎', -320)
           END-EXEC.
           IF  SQLCODE NOT = ZERO PERFORM ERROR-RTN.

           EXEC SQL
               INSERT INTO 従業員一覧
                VALUES (47, '沖縄　七郎', 480)
           END-EXEC.
           IF  SQLCODE NOT = ZERO PERFORM ERROR-RTN.

      *    INSERT ROWS USING HOST VARIABLE
           PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > 10
              MOVE TEST-NO(IDX)     TO  従業員番号
              MOVE TEST-NAME(IDX)   TO  氏名
              MOVE TEST-SALARY(IDX) TO  給与
              EXEC SQL
                 INSERT INTO 従業員一覧 VALUES
                        (:従業員番号, :氏名, :給与)
              END-EXEC
              IF  SQLCODE NOT = ZERO 
                  PERFORM ERROR-RTN
                  EXIT PERFORM
              END-IF
           END-PERFORM.

      *    COMMIT
           EXEC SQL COMMIT WORK END-EXEC.
           
      *    DISCONNECT
           EXEC SQL
               DISCONNECT ALL
           END-EXEC.
           
      *    END
           DISPLAY "*** INSERTTBL FINISHED ***".
           STOP RUN.

      ******************************************************************
       ERROR-RTN.
      ******************************************************************
           DISPLAY "*** SQL ERROR ***".
           DISPLAY "SQLCODE: " SQLCODE " " NO ADVANCING.
           EVALUATE SQLCODE
              WHEN  +10
                 DISPLAY "Record not found"
              WHEN  -01
                 DISPLAY "Connection falied"
              WHEN  -20
                 DISPLAY "Internal error"
              WHEN  -30
                 DISPLAY "PostgreSQL error"
                 DISPLAY "ERRCODE: "  SQLSTATE
                 DISPLAY SQLERRMC
              *> TO RESTART TRANSACTION, DO ROLLBACK.
                 EXEC SQL
                     ROLLBACK
                 END-EXEC
              WHEN  OTHER
                 DISPLAY "Undefined error"
                 DISPLAY "ERRCODE: "  SQLSTATE
                 DISPLAY SQLERRMC
           END-EVALUATE.
      ******************************************************************
])

AT_DATA([FETCHTBL.cbl], [
       IDENTIFICATION              DIVISION.
      ******************************************************************
       PROGRAM-ID.                 FETCHTBL.
      ******************************************************************
       DATA                        DIVISION.
      ******************************************************************
       WORKING-STORAGE             SECTION.
       01  D-EMP-REC.
           05  D-EMP-NO            PIC  9(04).
           05  FILLER              PIC  X.
           05  D-EMP-NAME          PIC  X(20).
           05  FILLER              PIC  X.
           05  D-EMP-SALARY        PIC  --,--9.

       EXEC SQL BEGIN DECLARE SECTION END-EXEC.
       01  データベース名            PIC  X(30) VALUE SPACE.
       01  ユーザー名                PIC  X(30) VALUE SPACE.
       01  パスワード                PIC  X(10) VALUE SPACE.
       01  EMP-REC-VARS.
         03  従業員番号              PIC S9(04) VALUE ZERO.
         03  氏名                   PIC  X(20) .
         03  給与                   PIC S9(04) VALUE ZERO.
       01  従業員数                 PIC  9(04).
       EXEC SQL END DECLARE SECTION END-EXEC.

       EXEC SQL INCLUDE SQLCA END-EXEC.
      ******************************************************************
       PROCEDURE                   DIVISION.
      ******************************************************************
       MAIN-RTN.
           DISPLAY "*** FETCHTBL STARTED ***".
           
      *    CONNECT
           MOVE  "<|DB_NAME|>@<|DB_HOST|>:<|DB_PORT|>"
             TO データベース名.
           MOVE  "<|DB_USER|>"
             TO ユーザー名.
           MOVE  "<|DB_PASSWORD|>"
             TO パスワード.
           EXEC SQL
               CONNECT :ユーザー名 IDENTIFIED BY :パスワード USING :データベース名 
           END-EXEC.
           IF  SQLCODE NOT = ZERO PERFORM ERROR-RTN STOP RUN.
           
      *    SELECT COUNT(*) INTO HOST-VARIABLE
           EXEC SQL 
               SELECT COUNT(*) INTO :従業員数 FROM 従業員一覧
           END-EXEC.
           DISPLAY "TOTAL RECORD: " 従業員数.
           
      *    DECLARE CURSOR
           EXEC SQL 
               DECLARE C1 CURSOR FOR
               SELECT 従業員番号, 氏名, 給与 
                      FROM 従業員一覧
                      ORDER BY 従業員番号
           END-EXEC.
           EXEC SQL
               OPEN C1
           END-EXEC.
           
      *    FETCH
           DISPLAY "---- -------------------- ------".
           DISPLAY "番号  氏名                 給与".
           DISPLAY "---- -------------------- ------".
           EXEC SQL 
               FETCH C1 INTO :従業員番号, :氏名, :給与
           END-EXEC.
           PERFORM UNTIL SQLCODE NOT = ZERO
              MOVE  従業員番号        TO    D-EMP-NO
              MOVE  氏名             TO    D-EMP-NAME
              MOVE  給与             TO    D-EMP-SALARY
              DISPLAY D-EMP-REC
              EXEC SQL 
                  FETCH C1 INTO :従業員番号, :氏名, :給与
              END-EXEC
           END-PERFORM.
           
      *    CLOSE CURSOR
           EXEC SQL 
               CLOSE C1 
           END-EXEC. 
           
      *    COMMIT
           EXEC SQL 
               COMMIT WORK
           END-EXEC.
           
      *    DISCONNECT
           EXEC SQL
               DISCONNECT ALL
           END-EXEC.
           
      *    END
           DISPLAY "*** FETCHTBL FINISHED ***".
           STOP RUN.

      ******************************************************************
       ERROR-RTN.
      ******************************************************************
           DISPLAY "*** SQL ERROR ***".
           DISPLAY "SQLCODE: " SQLCODE " " NO ADVANCING.
           EVALUATE SQLCODE
              WHEN  +10
                 DISPLAY "Record not found"
              WHEN  -01
                 DISPLAY "Connection falied"
              WHEN  -20
                 DISPLAY "Internal error"
              WHEN  -30
                 DISPLAY "PostgreSQL error"
                 DISPLAY "ERRCODE: "  SQLSTATE
                 DISPLAY SQLERRMC
              *> TO RESTART TRANSACTION, DO ROLLBACK.
                 EXEC SQL
                     ROLLBACK
                 END-EXEC
              WHEN  OTHER
                 DISPLAY "Undefined error"
                 DISPLAY "ERRCODE: "  SQLSTATE
                 DISPLAY SQLERRMC
           END-EVALUATE.
      ******************************************************************
])

AT_CHECK([${EMBED_DB_INFO} INSERTTBL.cbl])
AT_CHECK([${EMBED_DB_INFO} FETCHTBL.cbl])

AT_CHECK([${OCESQL} INSERTTBL.cbl INSERTTBL.cob > /dev/null], [0])
AT_CHECK([${OCESQL} FETCHTBL.cbl FETCHTBL.cob > /dev/null], [0])

AT_CHECK([${COMPILE} -variable INSERTTBL.cob], [0])
AT_CHECK([${COMPILE} -variable FETCHTBL.cob], [0])

AT_CHECK([java INSERTTBL > /dev/null], [0])
AT_CHECK([COB_TERMINAL_ENCODING=UTF8 java FETCHTBL], [0], 
[*** FETCHTBL STARTED ***
TOTAL RECORD: 0012
---- -------------------- ------
番号  氏名                 給与
---- -------------------- ------
0001 北海　太郎              400
0002 青森　次郎              350
0003 秋田　三郎              300
0004 岩手　四郎             -250
0005 宮城　五郎             -200
0006 福島　六郎              150
0007 栃木　七郎             -100
0008 茨城　八郎               50
0009 群馬　九郎             -200
0010 埼玉　十郎              350
0046 鹿児島　六郎           -320
0047 沖縄　七郎              480
*** FETCHTBL FINISHED ***
])

AT_CLEANUP
